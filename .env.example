# Server-only configuration; no privileged key is needed for normal operations.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Supabase Auth sends reset emails. Configure custom SMTP in its dashboard.
# Bank APIs, billing and government submission are not configured/implemented.

# Optional, server-only payslip email delivery (Resend verified sender).
RESEND_API_KEY=
PAYSLIP_FROM_EMAIL=
